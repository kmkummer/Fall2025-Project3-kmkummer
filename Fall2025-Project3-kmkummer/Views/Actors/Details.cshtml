@model Fall2025_Project3_kmkummer.Models.ViewModels.ActorDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Actor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Actor.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Actor.Name)
        </dd>
        <dt class="col-sm-2">
            Photo
        </dt>
        <dd class="col-sm-10">
            @if (Model.Actor.Photo != null && Model.Actor.Photo.Length > 0)
            {
                <img src="@Url.Action("Photo", "Actors", new { id = Model.Actor.Id })"
                     alt="Photo of @Model.Actor.Name"
                     style="max-width:200px; max-height:300px; object-fit:cover;" />
            }
            else
            {
                <span><em>No photo uploaded.</em></span>
            }
        </dd>
        <dt class="col-sm-2">
            IMDB
        </dt>
        <dd class="col-sm-10">
            @{
                var link = Model.Actor.Link;
                <a href="@link" target="_blank" rel="noopener">@link</a>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Actor.Gender)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Actor.Gender)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Actor.Age)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Actor.Age)
        </dd>
    </dl>
</div>

    <h3>Movies</h3>
    <ul>
    @foreach (var ma in Model.Actor.MovieActors)
    {
        <li>
            <a asp-controller="Movies" asp-action="Details" asp-route-id="@ma.Movie.Id">
                @ma.Movie.Title
            </a>
        </li>
    }
    </ul>

<h3 class="mt-4">Overall Sentiment: (@Model.AverageSentiment.ToString("0.000"))</h3>

@if (Model.AITweets.Count > 0)
{
    <table id="ActorTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Tweets</th>
                <th>Sentiment</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.AITweets.Count; i++)
            {
                <tr>
                    <td>@Model.AITweets[i]</td>
                    <td>@(i<Model.TweetSentiments.Count? Model.TweetSentiments[i].ToString("0.000") : "")</td>
                </tr>
            }
        </tbody>
    </table>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Actor?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>



@section Scripts {

    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.min.css"
          integrity="sha512-L8i3WWTzIHDoqFcF6YW/Fr0iC8IRlN64b/YwPlPIf8o6VLE2re+7442BbEGFIyWvmqYqK6UvDJpPZxTn+rN/mQ=="
          crossorigin="anonymous">
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"
            integrity="sha512-aDicMCy0pnN7hqhfSgvagdrS85SkNmmqWTkcQaGzlvW7UMWcCZ8WVYz7PLICHB6DXDprRlzuu4Od4MyXQ2spQw=="
            crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js"
            integrity="sha512-Cwi0jz7fz7mrX990DlJ1+rmiH/D9/rjfOoEex8C9qrPRDDqwMPdWV7pJFKzhM10gAAPlufZcWhfMuPN699Ej0w=="
            crossorigin="anonymous"></script>
    <script>
            $(document).ready(function () {
                $('#ActorTable').DataTable({
                    pageLength: 10,
                    searching: true
                });
            });
    </script>
}